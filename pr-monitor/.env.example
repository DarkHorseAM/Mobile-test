# --- Database (Neon pooled connection string) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the deployed app (Vercel sets this automatically in prod)
AUTH_URL=http://localhost:3000

# --- Email magic-link sign-in (optional, enables EmailProvider) ---
# Create a free account at resend.com, then verify a sending domain.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=PR Monitor <onboarding@resend.dev>

# --- Google OAuth (optional, enables GoogleProvider) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Access control ---
# Comma-separated list of emails allowed to sign in. Leave blank to allow all.
ALLOWED_EMAILS=

# --- Cron secret ---
# Vercel Cron sets an Authorization: Bearer <secret> header on cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=
