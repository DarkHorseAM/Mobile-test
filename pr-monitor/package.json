{
  "name": "pr-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "db:migrate": "tsx --env-file=.env.local lib/db/migrate.ts",
    "scan": "tsx --env-file=.env.local lib/scanner/run.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.4",
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.5.5",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
